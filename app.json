{
  "expo": {
    "name": "ProCopper Recycling",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/procopper-app-icon.png",
    "backgroundColor": "#004162",
    "primaryColor": "#004162",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/procopper-app-icon.png",
      "bundleIdentifier": "com.procopper.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#004162",
        "foregroundImage": "./assets/images/procopper - siteicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.procopper.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/procopper - siteicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#004162",
          "image": "./assets/images/procopper - siteicon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "light"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}